{
  "name": "ahnsen-live-quiz",
  "version": "13.1.0",
  "private": true,
  "description": "QuizTime mit gehärtetem PostgreSQL-Start, fehlerfreier Analytics, reproduzierbaren Browsertests und Node.js 24",
  "main": "server.js",
  "scripts": {
    "start": "node start.js",
    "check": "node scripts/check-js.js",
    "test:core": "node test/run-isolated.js",
    "test:catalog": "node tests/catalog-quality.test.js",
    "test:browser": "node scripts/run-playwright.js test",
    "test:production-smoke": "node scripts/run-playwright.js test e2e/production-smoke.spec.js",
    "test:production-readiness": "node scripts/production-readiness.js",
    "test:release-readiness": "node scripts/release-readiness.js",
    "test:postgres-log": "node scripts/check-postgres-log.js postgres.log",
    "test:restore": "node scripts/verify-backup-restore.js",
    "test:stability": "node test/stability-v101.test.js",
    "test:all": "npm run check && npm run test:core && npm run test:catalog",
    "test:load": "node scripts/load-smoke.js",
    "backup:critical": "node scripts/backup-critical-data.js",
    "restore:critical": "node scripts/restore-critical-data.js"
  },
  "engines": { "node": ">=24 <25" },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "express": "4.22.2",
    "pg": "8.13.1",
    "socket.io": "4.8.1"
  }
}
