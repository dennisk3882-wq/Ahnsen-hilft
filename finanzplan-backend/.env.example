# Public app URL
APP_ORIGIN=https://finanzplan-pwa.onrender.com

# Supabase (server secret; NEVER put SERVICE_ROLE_KEY in the PWA)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Enable Banking for personal N26 access
ENABLE_BANKING_APP_ID=YOUR_ENABLE_BANKING_APP_ID
ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
STATE_SECRET=GENERATE_A_RANDOM_32_BYTE_OR_LONGER_SECRET

# Optional cloud AI. Leave empty to keep AI completely free/local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Web Push
VAPID_PUBLIC_KEY=GENERATED_PUBLIC_KEY
VAPID_PRIVATE_KEY=GENERATED_PRIVATE_KEY
VAPID_SUBJECT=mailto:YOUR_EMAIL
CRON_SECRET=ANOTHER_LONG_RANDOM_SECRET
